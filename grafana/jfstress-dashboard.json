    {
      "type": "timeseries",
      "title": "Streams by mode and state",
      "id": 11,
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "description": "",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 17
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "sum by (mode, state) (jfstress_streams)",
          "legendFormat": "{{mode}} {{state}}",
          "refId": "A",
          "range": true
